# FFI B9-4: transient cc/ld artifacts — regenerated by build.sh on demand.
# Only the hand-authored stubs (jconfig.h, jconfigint.h, jversion.h) and
# the *_link.log captures from the reference link-failure run are tracked.
build/*.o
build/djpeg
build/cjpeg
build/jpegtran
build/link_errors.txt
build/*_build.log
# Generated jconfig headers rebuilt by build.sh
build/jconfig.h
build/jconfigint.h
